<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Every asset belongs to exactly one product (OAuth client). The column is NOT
      NULL because no asset was ever stored before this change set: there is no
      pre-existing row to backfill, and an unscoped upload is now rejected at the
      API boundary instead of being parked in a shared directory.
    -->
    <changeSet id="002-01-media-asset-client" author="mijery">
        <addColumn tableName="media_asset">
            <column name="client_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex tableName="media_asset" indexName="idx_media_asset_client">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <!--
      The product's brand logo, which doubles as the watermark for that product's
      protected assets. One row per client: a product has one logo, replaced in
      place. storage_key is relative to the logo root so the root can move.
    -->
    <changeSet id="002-02-product-logo" author="mijery">
        <createTable tableName="product_logo">
            <column name="client_id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="storage_key" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="mime" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="width" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="height" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
