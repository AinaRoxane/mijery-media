# MIJERY MEDIA Configuration

# Server
PORT=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=YOUR_MEDIA_DB_NAME
DB_USER=YOUR_DB_USER
DB_PWD=YOUR_DB_PASSWORD

# Storage
MIJERY_MEDIA_STORAGE_DIR=./media-storage
MIJERY_MEDIA_VIPS_BIN=vips

# Security
MIJERY_MEDIA_SIGNING_SECRET=change-me-in-production
MIJERY_MEDIA_SIGNED_URL_TTL=600

# Variants
MIJERY_MEDIA_VARIANT_WIDTHS=320,640,1080,1600
MIJERY_MEDIA_MAX_UPLOAD_BYTES=10485760
MIJERY_MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Watermark
MIJERY_MEDIA_WATERMARK_PATH=
MIJERY_MEDIA_WATERMARK_OPACITY=35